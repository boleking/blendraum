{
  "name": "twin-test",
  "version": "0.1.0",
  "private": true,
  "description": "Twin Test – Fundament eines Digital-Twin-Viewers (Platzhalter)",
  "type": "module",
  "scripts": {
    "models": "node scripts/build-models.mjs public",
    "dev": "npm run models && vite",
    "check:public": "node scripts/check-public.mjs",
    "import": "node scripts/import/run.mjs",
    "build": "npm run check:public && npm run models && tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:bundle": "npm run check:public && npm run models && tsc --noEmit && VITE_MODEL_BUNDLE=1 vite build --outDir dist-bundle && node scripts/bundle-models.mjs dist-bundle",
    "test": "vitest run",
    "shots": "node scripts/shots.mjs",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "geotiff": "^2.1.3",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
